# Copie este arquivo para app/.env.coolify e preencha o token.
# O .env.coolify NAO e versionado (esta no .gitignore). Este .example pode ser commitado.
#
# Token: no painel Coolify -> Keys & Tokens -> API tokens (formato N|xxxx, com | literal).
# IMPORTANTE: nao coloque aspas no valor. Os scripts do skill medmaestro-deploy leem o
# valor com grep/cut (nao com `source`), entao o | do token e preservado corretamente.

COOLIFY_BASE=http://187.77.250.197:8000
COOLIFY_APP_UUID=ldtodn3k88mw50ortjjw8ib0
COOLIFY_API_TOKEN=
HEALTH_URL=https://medmaestro.com.br/api/health

# --- Necessarios apenas para CRIAR o app no Coolify quando ele nao existir ---
# Descubra os UUIDs com:  bash .claude/skills/medmaestro-deploy/scripts/coolify-create.sh --discover
COOLIFY_SERVER_UUID=
COOLIFY_PROJECT_UUID=
COOLIFY_ENVIRONMENT=production
