# Supabase — obter em: Settings > API no painel do projeto
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=seu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=seu_service_role_key_aqui

# Claude API — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Gotenberg — conversor DOCX/PPTX -> PDF (serviço sidecar). Opcional: sem ele, o
# upload de caderno em PDF funciona normalmente; só DOCX/PPTX exigem este serviço.
# Em produção (Coolify) aponte para o serviço interno, ex.: http://gotenberg:3000
GOTENBERG_URL=
# GOTENBERG_TIMEOUT_MS=120000

# Camada do aluno (feature 005) — subdomínio
NEXT_PUBLIC_ALUNO_HOST=aluno.medmaestro.com.br
NEXT_PUBLIC_ALUNO_URL=https://aluno.medmaestro.com.br
